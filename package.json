{
  "name": "wrecked-apartment",
  "version": "1.0.0",
  "description": "3D model viewer and project management for Rec Department fabrication team",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
